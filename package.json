{
  "name": "feedme-order-controller",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b packages/core packages/cli packages/api && npm run build:web && tsc -p packages/web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -b packages/core packages/cli packages/api --pretty false && tsc -p packages/web/tsconfig.json --noEmit --pretty false",
    "demo": "tsx packages/cli/src/index.ts demo",
    "cli:interactive": "tsx packages/cli/src/index.ts interactive",
    "dev:api": "tsx watch packages/api/src/index.ts",
    "start:api": "node packages/api/dist/index.js",
    "dev:web": "vite --config packages/web/vite.config.ts",
    "build:web": "vite build --config packages/web/vite.config.ts",
    "preview:web": "vite preview --config packages/web/vite.config.ts"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
