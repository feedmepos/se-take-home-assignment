{
  "name": "se-take-home-assignment",
  "version": "1.0.0",
  "description": "Below is a take home assignment before the interview of the position. You are required to 1. Understand the situation and use case. You may contact the interviewer for further clarification. 2. implement the requirement with **either frontend or backend components**. 3. Complete the requirement with **AI** if possible, but perform your own testing. 4. Provide documentation for the any part that you think is needed. 5. Bring the source code and functioning prototype to the interview session.",
  "main": "server.ts",
  "scripts": {
    "prettier:check": "prettier \"src/**/*\" --check",
    "prettier:watch": "onchange \"src/**/*\" -- prettier --write --ignore-unknown {{changed}}",
    "lint:watch": "onchange \"src/**/*\" -- eslint {{changed}}",
    "dev": "nodemon --watch 'src/**' --ext 'js,ts,json' --ignore 'src/**/*.spec.ts' --exec npm start",
    "dev2": "concurrently npm:start npm:prettier:watch npm:lint:watch",
    "start": "ts-node src/server.ts",
    "create-rsa": "./rsa-key-generator.sh",
    "build-image": "sudo docker build .",
    "eslint": "./node_modules/eslint/bin/eslint.js --debug ./src/",
    "test-script": "./initiate-tests.sh",
    "test": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feedmepos/se-take-home-assignment.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/feedmepos/se-take-home-assignment/issues"
  },
  "homepage": "https://github.com/feedmepos/se-take-home-assignment#readme",
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "joi": "^18.0.2",
    "moment": "^2.30.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "jest": "^30.2.0",
    "onchange": "^7.1.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3"
  }
}
