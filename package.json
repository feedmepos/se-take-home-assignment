{
  "name": "feedme-order-cli",
  "version": "1.0.0",
  "description": "NestJS-based CLI backend for FeedMe SE take-home assignment",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start:cli": "ts-node src/main.cli.ts",
    "start:api": "ts-node src/main.api.ts",
    "start:dev": "ts-node -r ts-node/register/transpile-only src/main.ts",
    "test": "jest"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.4.22",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.0.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.22",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.0"
  }
}
