    "@angular/fire": "^20.0.1",
    "@angular/forms": "^21.2.0",
    "@angular/google-maps": "^21.2.1",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@emailjs/browser": "^4.4.1",
    "@formkit/tempo": "^1.0.0",
    "@jsverse/transloco": "^8.2.1",
    "@jsverse/transloco-schematics": "^8.2.1",
